# Copy this file to .env and fill in real values. Bun loads .env from the
# project root automatically — see the "Running the hosted app" section in
# README.md for what each variable means and which commands need it.

# --- GitHub App (required by every command) ---------------------------------
# The GitHub App's numeric ID.
CR_APP_ID=

# Filesystem path to the GitHub App's private key (.pem). Never committed —
# point this at a key file that lives outside version control.
CR_PRIVATE_KEY_PATH=

# The numeric ID of the GitHub App installation to act on. Required by
# `prepare`/`plan`; loaded but not used by `serve` (which resolves the
# installation from the signed-in session instead) — any placeholder
# positive integer works if you're only running `serve`.
CR_INSTALLATION_ID=

# The npm package scope this installation manages, e.g. "@acme/".
CR_SCOPE=

# Comma-separated status check name(s) your own repos' CI already produces
# on pull requests, e.g. "build,test". Required by every command, including
# `serve` (used by the hosted /api/repos readiness check); never
# "chainreaction-validate" itself.
CR_REQUIRED_CHECKS=

# --- GitHub OAuth App (required by `serve` only) -----------------------------
# The GitHub OAuth App's client ID.
CR_OAUTH_CLIENT_ID=

# The GitHub OAuth App's client secret. Never commit a real value here.
CR_OAUTH_CLIENT_SECRET=

# Random secret used to sign session cookies. Generate with:
#   openssl rand -hex 32
CR_SESSION_SECRET=

# The full, absolute callback URL registered with the GitHub OAuth App, e.g.
# "https://app.example.com/auth/callback". Use https:// in any real
# deployment; http:// is a documented dev-only fallback (see
# src/server/index.ts) that drops the __Host- cookie prefix and Secure flag.
CR_OAUTH_CALLBACK_URL=
